<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KatalogMobilny.NewProductPage"
             Title="Nowy produkt">
    <!-- Grid: góra = formularz (*), dół = przycisk (Auto), więc przycisk jest zawsze na dole ekranu -->
    <Grid RowDefinitions="*,Auto" Padding="16">

        <!-- ScrollView, żeby formularz dało się przewinąć, gdy jest dużo pól -->
        <ScrollView Grid.Row="0">
            <!-- Spacing 24 = odstęp między grupami -->
            <VerticalStackLayout Spacing="24">

                <!-- grupa 1: nazwa (Spacing 8 = odstęp w grupie) -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Nazwa" />
                    <!-- TextChanged = zdarzenie po każdym wpisanym znaku -->
                    <Entry x:Name="NazwaEntry" Placeholder="Wpisz nazwę" HeightRequest="44"
                           TextChanged="NazwaEntry_TextChanged" />
                </VerticalStackLayout>

                <!-- grupa 2: kategoria -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Kategoria" />
                    <!-- SelectedIndexChanged = zdarzenie po wyborze pozycji -->
                    <Picker x:Name="KategoriaPicker" Title="Wybierz kategorię" HeightRequest="44"
                            SelectedIndexChanged="KategoriaPicker_SelectedIndexChanged" />
                </VerticalStackLayout>

                <!-- grupa 3: dostępność, wiersz ma min. 44 wysokości -->
                <HorizontalStackLayout Spacing="8" HeightRequest="44">
                    <!-- Toggled = zdarzenie po przełączeniu -->
                    <Switch x:Name="AvailableSwitch" VerticalOptions="Center"
                            Toggled="AvailableSwitch_Toggled" />
                    <!-- przełącznik startuje wyłączony, więc na start produkt jest niedostępny -->
                    <Label x:Name="DostepnoscLabel" Text="Produkt niedostępny" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!-- etykieta, w której pokazujemy wynik zdarzeń -->
                <Label x:Name="EtykietaWyniku" Text="Nic nie wpisano" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- przycisk główny: pełna szerokość, wysokość 52, na dole -->
        <Button Grid.Row="1" Text="Dodaj produkt" HeightRequest="52"
                HorizontalOptions="Fill" Margin="0,8,0,0" />
    </Grid>
</ContentPage>
