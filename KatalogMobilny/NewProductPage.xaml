<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KatalogMobilny.NewProductPage"
             Title="NewProductPage">
    <VerticalStackLayout>
        <Label 
            Text="Welcome to .NET MAUI!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Label Text="Nazwa" />
        <Entry x:Name="NazwaEntry" Placeholder="0" Keyboard="Numeric"/>
        <Picker x:Name="KategoriaPicker" Title="Wybierz kategorię">
            <Picker.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>Procesory</x:String>
                    <x:String>Płyty Główne</x:String>
                    <x:String>Karty Graficzne</x:String>
                    <x:String>Dyski SSD</x:String>
                    <x:String>Pamięci RAM</x:String>
                </x:Array>
            </Picker.ItemsSource>
        </Picker>
        <HorizontalStackLayout>
            <Switch x:Name="AvailableSwitch" />
            <Label Text="Produkt Dostępny" VerticalOptions="Center"/>
        </HorizontalStackLayout>
        <Button Text="Dodaj produkt"/>
    </VerticalStackLayout>
</ContentPage>