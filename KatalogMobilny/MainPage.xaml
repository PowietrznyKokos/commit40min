<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KatalogMobilny.MainPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="Procesor" FontSize="12" FontAttributes="Bold"
            TextColor="#008BFF" HorizontalOptions="Center" Margin="0,20"/>
        <Image Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
               Source="procesor.jpg" Aspect="AspectFit" />
        <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
               Text="Cena: 899 zł" TextColor="Gray" />
        <Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                x:Name="EtykietaWyniku" Text="Nic nie wybrano" />
        <Button Grid.Row="4" Grid.Column="0" Text="Pokaż" Clicked="PokazClicked"/>
        <Button Grid.Row="4" Grid.Column="1" Text="Ukryj" Clicked="UkryjClicked"/>
    </Grid>
</ContentPage>
